HSI_APP_MODE=local
HSI_RUNTIME_ROOT=runtime
HSI_DEPLOY_CONFIG=configs/deploy/hypersigma_v3_calibrated.json
HSI_OUTPUT_ROOT=outputs
HSI_OUTPUT_URL_PREFIX=/outputs
HSI_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HSI_CORS_ALLOW_CREDENTIALS=false
HSI_ALLOW_SERVER_FILE_PATHS=true
HSI_ALLOW_DEPLOY_CONFIG_OVERRIDE=true
HSI_INFERENCE_RUNTIME=current
HSI_INFERENCE_CONDA_ENV=HyperSIGMA
# HSI_MODEL_CHECKPOINT=runtime/assets/models/E02_head_only_posw_v3_block224/model_best.pt
# HSI_TEMPERATURE_JSON=runtime/assets/models/E02_head_only_posw_v3_block224/temperature_scaling_val.json
# HSI_THRESHOLD=0.327428693347738
# HSI_MANIFEST_PATH=runtime/assets/manifests/wetness_manifest_from_confidence_ali_blocksplit.csv
# HSI_DATASET_PATH=runtime/assets/datasets/wetness_pretrain_v3_minimal
# HSI_INFERENCE_PYTHON_BIN=/absolute/path/to/python
HYPERSIGMA_ROOT=/absolute/path/to/HyperSIGMA
HYPERSIGMA_SPAT_CHECKPOINT=/absolute/path/to/spat-vit-b-checkpoint-1599.pth
HYPERSIGMA_SPEC_CHECKPOINT=/absolute/path/to/spec-vit-b-checkpoint-1599.pth
