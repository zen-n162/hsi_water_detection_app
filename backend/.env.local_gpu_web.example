HSI_APP_MODE=local_gpu_web
HSI_DEPLOY_CONFIG=configs/deploy/hypersigma_v3_local_gpu_web.json
HSI_CORS_ALLOW_ORIGINS=https://<your-netlify-site>.netlify.app
HSI_OUTPUT_ROOT=outputs/web_ui
HSI_OUTPUT_URL_PREFIX=/outputs
HSI_ALLOW_SERVER_FILE_PATHS=false
HSI_ALLOW_DEPLOY_CONFIG_OVERRIDE=false
HSI_DEFAULT_DEVICE=cuda
HSI_INFERENCE_RUNTIME=current
HSI_PUBLIC_BASE_URL=https://<your-tunnel-domain>
HYPERSIGMA_ROOT=/home/zennakamura/MasterResearch/HyperSIGMA
HYPERSIGMA_SPAT_CHECKPOINT=/home/zennakamura/MasterResearch/HyperSIGMA/HyperspectralDetection/spat-vit-b-checkpoint-1599.pth
HYPERSIGMA_SPEC_CHECKPOINT=/home/zennakamura/MasterResearch/HyperSIGMA/HyperspectralDetection/spec-vit-b-checkpoint-1599.pth
